# Copy this file to .env (or set these as real environment variables) when
# running the backend outside of Docker Compose defaults.

# Port the HTTP/WebSocket server listens on.
PORT=8080

# Filesystem path to the SQLite database file. Its parent directory is
# created automatically. Point this at a persistent volume in production.
DB_PATH=./data/sequencer.db

# CORS origin allowed to call this API. Use "*" for local development;
# set this to your deployed frontend's exact origin in production, e.g.
# https://media-sequencer.vercel.app
ALLOWED_ORIGIN=*

# Insert the 3 demo windows (W1/W2/W3) with sample playlists the first time
# the server starts against an empty database. Safe to leave true; it never
# re-seeds once at least one window exists.
SEED_ON_EMPTY=true

# Delay (seconds) between a sync being triggered and it actually starting,
# giving every connected client time to receive the WebSocket broadcast
# before the synchronized start moment arrives.
SYNC_LEAD_SECONDS=2

# How long (seconds) a synced item stays on screen when the client doesn't
# specify its own duration_seconds in the sync request.
DEFAULT_SYNC_DURATION_SECONDS=10

# Optional shared secret. If set, mutating endpoints (POST, PUT, DELETE) will
# require an X-Admin-Token header matching this value.
# ADMIN_TOKEN=secret123
