# Copy to .env.local for local development (Vite auto-loads it).
# Base URL of the Golang backend's HTTP API. The WebSocket URL is derived
# from this automatically (http -> ws, https -> wss) by src/api.js.
VITE_API_BASE_URL=http://localhost:8080

# Optional shared secret. If the backend requires ADMIN_TOKEN, set this to
# the same value so the frontend sends it as the X-Admin-Token header.
# VITE_ADMIN_TOKEN=secret123
